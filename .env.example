# Copy to .env.local. Never commit live keys.
APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Stripe Connect platform credentials (start in test mode).
STRIPE_SECRET_KEY=
STRIPE_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
# Separate platform webhook for Inferlytic's lifetime purchases.
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_LTD_TIER_1_PRICE_ID=
STRIPE_LTD_TIER_2_PRICE_ID=
STRIPE_LTD_TIER_3_PRICE_ID=
# Optional outbound notifications. Never used by demo mode.
RESEND_API_KEY=
ALERT_FROM_EMAIL=
# Generate a random secret for POST /api/jobs/daily.
CRON_SECRET=
